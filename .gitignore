# ==============================================================================
# Rust / Cargo
# ==============================================================================
# Generated by Cargo
# Will contain compiled artifacts and dependencies
/target/
**/target/

# Remove Cargo.lock from gitignore if this is an application/binary (which zapreq is)
# but we explicitly ignore cargo backup files
**/*.rs.bk

# ==============================================================================
# Tauri Desktop App
# ==============================================================================
/src-tauri/target/
/src-tauri/gen/
/src-tauri/bin/

# ==============================================================================
# Node.js / React / Vite Frontend
# ==============================================================================
# Dependency directories
node_modules/
**/node_modules/

# Production build outputs
dist/
**/dist/
dist-ssr/
build/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / Lint caches
.eslintcache
.stylelintcache
.prettiercache
.parcel-cache
.cache/

# Local env files (highly critical: do not commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# ==============================================================================
# IDEs and Text Editors
# ==============================================================================
# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.code-workspace
.history/

# IntelliJ / JetBrains
.idea/
*.iws
*.iml
*.ipr

# Vim / Emacs swap and backup files
*~
*.swp
*.swo
.netrwhist

# ==============================================================================
# Operating System Files
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.lnk
*.cab

# ==============================================================================
# Local Project specific
# ==============================================================================
/diagram/
/test-reports/
*.db-journal
